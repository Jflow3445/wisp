[Unit]
Description=NISTER tunnel watchdog (L2TP/IPsec auto-recovery)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TARGET_IP=10.10.20.2
Environment=REQUIRED_DEVS=ppp0,ppp1
Environment=PROBE_MODE=ping
Environment=COOLDOWN_SEC=1800
Environment=RESTART_WINDOW_SEC=3600
Environment=MAX_RESTARTS_PER_WINDOW=3
Environment=STILL_DOWN_EXIT_CODE=2
Environment=POST_RESTART_WAIT_SEC=120
Environment=POST_RESTART_POLL_SEC=5
Environment=TUNNEL_ROUTES=10.10.20.4/32,192.168.80.0/20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/run /var/log/nister
ExecStart=/usr/bin/flock -n /run/nister_tunnel_watchdog.lock /usr/local/sbin/nister_tunnel_watchdog.sh
SuccessExitStatus=2
