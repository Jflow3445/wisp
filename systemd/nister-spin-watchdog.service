[Unit]
Description=NISTER Spin inactivity watchdog and financial reconciliation
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
TimeoutStartSec=50s
ExecStart=/usr/bin/php /srv/nister-wisp-repo/pay-portal/cron/spin_watchdog.php
