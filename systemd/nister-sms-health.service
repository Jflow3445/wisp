[Unit]
Description=Nister SMS gateway balance and connectivity checks
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /var/www/pay/cron/sms_health.php
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
