[Unit]
Description=Nister radacct cleanup (close stale/duplicate open sessions)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=STALE_MINUTES=10
ExecStart=/usr/bin/flock -n /run/nister_radacct_cleanup.lock /usr/local/sbin/nister_radacct_cleanup.sh
SuccessExitStatus=1

# Optional overrides:
# Environment=STALE_MINUTES=10
# Environment=DRY_RUN=0
