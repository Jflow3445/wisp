{
  "expo": {
    "name": "NISTER Vendor",
    "slug": "nister-vendor",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nister-vendor",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nister.market.vendor"
    },
    "android": {
      "package": "org.nister.market.vendor"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
