{
  "name": "@nister/commerce-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @nister/database db:generate",
    "db:migrate": "pnpm --filter @nister/database db:migrate",
    "db:seed": "pnpm --filter @nister/database db:seed",
    "check:wisp-boundary": "sh scripts/check-wisp-boundary.sh",
    "format": "prettier --write .",
    "check": "pnpm check:wisp-boundary && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.19.13",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
