# Copy to ops/.env.ops (gitignored) and fill values.
# This file is sourced by bash scripts in ops/.

# VPS access (required)
VPS_HOST=209.97.137.68
VPS_USER=root
# One of VPS_PASS or VPS_SSH_KEY
VPS_PASS=
VPS_SSH_KEY=

# Router access from VPS
ROUTER_HOST=10.10.20.2
ROUTER_USER=certsync
# One of ROUTER_PASS or ROUTER_SSH_KEY_ON_VPS
ROUTER_PASS=
ROUTER_SSH_KEY_ON_VPS=/root/.ssh/mikrotik_certsync

# Optional: tunnel IP used when fallback deploy uses /tool fetch from router
VPS_TUNNEL_IP=10.99.99.1
ROUTER_PUSH_HTTP_PORT=8089

# Optional: auto attempt RADIUS bind fix in check script (1/0)
AUTO_FIX_RADIUS_BIND=1
