generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum PlanTier {
  BASIC
  PRO_MANAGED
}

enum AutomationMarket {
  FOREX
  STOCKS
  OPTIONS
}

enum SubscriptionStatus {
  INACTIVE
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum UserAccountState {
  PENDING_REVIEW
  ACTIVE
  LIMITED
  SUSPENDED
  CLOSED
}

enum UserFundsState {
  UNFUNDED
  PENDING_VERIFICATION
  FUNDED
  RESTRICTED
}

enum UserTradeState {
  ONBOARDING
  READY
  LIVE
  PAUSED
  STOPPED
}

enum ExecutionMode {
  LOCAL
  MANAGED
}

enum ExecutionSessionStatus {
  ACTIVE
  CLOSED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  MANUAL_REVIEW
  CANCELLED
}

enum InvoiceAmountReservationStatus {
  RESERVED
  RELEASED
  CONSUMED
}

enum ProcessedTransferStatus {
  CREDITED
  REJECTED
}

enum ReferralCommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum PartnerPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
}

enum MarketEnrollmentStatus {
  WAITLIST_PENDING
  WAITLIST
  WAITLIST_PREPAID
  ACTIVE
  RELEASED
}

enum WaitlistLaunchEmailStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

enum MarketingBlastCampaignStatus {
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum MarketingBlastRecipientStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum ReferralIntegrityCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ReferralIntegritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  PAYMENT
  SYSTEM
  SUPPORT
}

enum BrokerAccountMode {
  DEMO
  REAL
}

enum BrokerAccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum AgentHostType {
  LOCAL
  VPS
}

enum AgentStatus {
  ACTIVE
  STANDBY
  REVOKED
  BLOCKED
}

enum OfferAddonBilling {
  ONE_TIME
  RECURRING
}

enum SocialAuthProvider {
  GOOGLE
  FACEBOOK
}

model User {
  id                             String                      @id @default(cuid())
  email                          String                      @unique
  name                           String
  passwordHash                   String
  emailVerifiedAt                DateTime?
  role                           UserRole                    @default(MEMBER)
  referralCode                   String?                     @unique
  referredById                   String?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  paymentSubmissions             PaymentSubmission[]
  reviewedPayments               PaymentSubmission[]         @relation("PaymentReviewedBy")
  notifications                  Notification[]
  preference                     UserPreference?
  tradingProfile                 UserTradingProfile?
  authRateLimit                  AuthRateLimit?
  referredBy                     User?                       @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                      User[]                      @relation("UserReferrals")
  commissionsEarned              ReferralCommission[]        @relation("ReferralCommissionsEarned")
  commissionsFromMe              ReferralCommission[]        @relation("ReferralCommissionsGenerated")
  partnerPayouts                 PartnerPayout[]             @relation("PartnerPayouts")
  partnerIntegrityCases          ReferralIntegrityCase[]     @relation("PartnerIntegrityCases")
  subscription                   Subscription?
  supportTickets                 SupportTicket[]
  emailTokens                    EmailVerificationToken[]
  passwordResetTokens            PasswordResetToken[]
  legalAcceptances               LegalAcceptance[]
  licensedEaClients              LicensedEaClient[]
  executionSessions              ExecutionSession[]
  executionLogs                  ExecutionLog[]
  brokerAccounts                 BrokerAccount[]
  userPolicies                   UserPolicy[]
  agents                         Agent[]
  enrollmentTokens               EnrollmentToken[]           @relation("EnrollmentTokensUser")
  enrollmentTokensCreated        EnrollmentToken[]           @relation("EnrollmentTokensCreatedBy")
  commandCandidates              CommandCandidate[]
  publishedCommands              PublishedCommand[]
  riskEvents                     RiskEvent[]
  executionReportsV2             ExecutionReport[]
  conversionEvents               ConversionEvent[]
  experimentAssignments          ExperimentAssignment[]
  onboardingRecoveryState        OnboardingRecoveryState?
  paymentOrders                  PaymentOrder[]
  marketEnrollments              MarketEnrollment[]
  waitlistLaunchEmails           WaitlistLaunchEmail[]
  companionSessions              CompanionSession[]
  flightRounds                   FlightRound[]
  flightWithdrawals              FlightWithdrawal[]
  flightEntries                  FlightWalletEntry[]
  flightPlayer                   FlightPlayer?
  flightReferralRewards          FlightReferralReward[] @relation("FlightReferralRecipient")
  flightReferredRewards          FlightReferralReward[] @relation("FlightReferralSource")
  socialAccounts                 UserSocialAccount[]
  marketingSequenceDispatches    MarketingSequenceDispatch[]
  marketingBlastCampaignsCreated MarketingBlastCampaign[]    @relation("MarketingBlastCreatedBy")
  marketingBlastRecipients       MarketingBlastRecipient[]

  @@index([referredById])
}

model BrokerAccount {
  id           String              @id @default(cuid())
  userId       String
  brokerName   String
  brokerServer String
  accountLogin String
  accountMode  BrokerAccountMode
  status       BrokerAccountStatus @default(PENDING)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy            UserPolicy?
  agents            Agent[]
  enrollmentTokens  EnrollmentToken[]
  commandCandidates CommandCandidate[]
  publishedCommands PublishedCommand[]
  executionReports  ExecutionReport[]
  heartbeats        AgentHeartbeat[]
  positionSnapshots PositionSnapshot[]
  leases            AgentLease[]
  riskEvents        RiskEvent[]

  @@unique([brokerServer, accountLogin])
  @@index([userId, status])
}

model UserPolicy {
  id                     String   @id @default(cuid())
  userId                 String
  brokerAccountId        String   @unique
  policyVersion          Int      @default(1)
  aiEnabled              Boolean  @default(true)
  closeOnlyMode          Boolean  @default(false)
  manualApprovalMode     Boolean  @default(false)
  maxRiskPerTradePct     Decimal  @db.Decimal(6, 3)
  maxDailyLossPct        Decimal  @db.Decimal(6, 3)
  maxOpenTradesTotal     Int      @default(0)
  maxOpenTradesPerSymbol Int      @default(0)
  maxSpreadPoints        Int
  maxSlippagePoints      Int
  weekendTradingAllowed  Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount      @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  symbols       UserPolicySymbol[]

  @@index([userId, updatedAt])
}

model UserPolicySymbol {
  id        String  @id @default(cuid())
  policyId  String
  symbol    String
  isAllowed Boolean

  policy UserPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, symbol])
}

model Agent {
  id                  String        @id @default(cuid())
  userId              String
  brokerAccountId     String
  deviceName          String
  hostType            AgentHostType
  terminalFingerprint String
  signingMode         String
  agentPublicKey      String?
  keyVersion          Int           @default(1)
  status              AgentStatus   @default(ACTIVE)
  lastHeartbeatAt     DateTime?
  lastIp              String?
  lastVersion         String?
  isExecutionLeader   Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount     BrokerAccount      @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  secrets           AgentSecret[]
  sessions          AgentSession[]
  heartbeats        AgentHeartbeat[]
  nonces            AgentNonce[]
  publishedCommands PublishedCommand[]
  executionReports  ExecutionReport[]
  positionSnapshots PositionSnapshot[]
  leases            AgentLease[]

  @@unique([brokerAccountId, terminalFingerprint])
  @@index([brokerAccountId, status, isExecutionLeader])
}

model AgentSecret {
  id               String   @id @default(cuid())
  agentId          String
  secretCiphertext String
  secretKeyVersion Int?
  keyVersion       Int
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, active, keyVersion])
}

model AgentSession {
  id               String    @id @default(cuid())
  agentId          String
  accessTokenJti   String    @unique
  refreshTokenHash String
  issuedAt         DateTime
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, revokedAt, accessExpiresAt])
}

model EnrollmentToken {
  id              String         @id @default(cuid())
  tokenHash       String         @unique
  userId          String
  brokerAccountId String
  allowedHostType AgentHostType?
  allowLeader     Boolean        @default(true)
  expiresAt       DateTime
  usedAt          DateTime?
  createdBy       String
  createdAt       DateTime       @default(now())

  user          User          @relation("EnrollmentTokensUser", fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  creator       User          @relation("EnrollmentTokensCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([brokerAccountId, expiresAt])
  @@index([userId, createdAt])
}

model AiService {
  id                      String   @id @default(cuid())
  serviceName             String   @unique
  status                  String
  keyVersion              Int      @default(1)
  ipAllowlist             String?
  signingSecret           String?
  signingSecretKeyVersion Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  models  AiServiceModel[]
  nonces  AiNonce[]
  actions AiAction[]
}

model AiServiceModel {
  id          String   @id @default(cuid())
  aiServiceId String
  modelId     String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  aiService AiService @relation(fields: [aiServiceId], references: [id], onDelete: Cascade)

  @@unique([aiServiceId, modelId])
}

model AiNonce {
  id          String   @id @default(cuid())
  aiServiceId String
  nonce       String
  seenAt      DateTime @default(now())
  expiresAt   DateTime

  aiService AiService @relation(fields: [aiServiceId], references: [id], onDelete: Cascade)

  @@unique([aiServiceId, nonce])
  @@index([expiresAt])
}

model AgentNonce {
  id        String   @id @default(cuid())
  agentId   String
  nonce     String
  seenAt    DateTime @default(now())
  expiresAt DateTime

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, nonce])
  @@index([expiresAt])
}

model AiAction {
  id                String   @id @default(cuid())
  actionId          String   @unique
  aiServiceId       String
  modelId           String
  modelVersion      String
  strategyId        String
  symbol            String
  assetClass        String
  actionType        String
  side              String
  confidence        Decimal? @db.Decimal(6, 5)
  reasonCode        String?
  riskProfileJson   Json
  marketContextJson Json
  issuedAt          DateTime
  receivedAt        DateTime @default(now())
  signature         String
  requestHash       String
  rawPayloadJson    Json

  aiService         AiService          @relation(fields: [aiServiceId], references: [id], onDelete: Cascade)
  candidates        CommandCandidate[]
  publishedCommands PublishedCommand[]

  @@index([symbol, issuedAt])
}

model CommandCandidate {
  id                       String   @id @default(cuid())
  actionId                 String
  userId                   String
  brokerAccountId          String
  targetAgentPolicy        String
  symbol                   String
  assetClass               String
  commandType              String
  side                     String
  sizingJson               Json
  executionConstraintsJson Json
  sl                       Decimal? @db.Decimal(18, 8)
  tp                       Decimal? @db.Decimal(18, 8)
  status                   String
  blockedReason            String?
  createdAt                DateTime @default(now())

  action        AiAction      @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([brokerAccountId, createdAt])
  @@index([status, createdAt])
}

model PublishedCommand {
  id              String   @id @default(cuid())
  commandId       String   @unique
  actionId        String
  userId          String
  brokerAccountId String
  agentId         String
  sequenceNo      BigInt
  symbol          String
  assetClass      String
  commandType     String
  side            String
  payloadJson     Json
  signature       String
  signatureKeyId  String
  issuedAt        DateTime
  expiresAt       DateTime
  leaseStatus     String
  executionStatus String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  action        AiAction          @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount     @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  agent         Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events        CommandEvent[]
  reports       ExecutionReport[]

  @@unique([agentId, sequenceNo])
  @@index([agentId, leaseStatus, sequenceNo])
  @@index([userId, issuedAt])
  @@index([agentId, leaseStatus, executionStatus, issuedAt])
  @@index([agentId, leaseStatus, executionStatus, expiresAt])
}

model CommandEvent {
  id               String   @id @default(cuid())
  commandId        String
  eventType        String
  eventPayloadJson Json
  createdAt        DateTime @default(now())

  command PublishedCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([commandId, createdAt])
}

model AgentHeartbeat {
  id                     String   @id @default(cuid())
  agentId                String
  brokerAccountId        String
  lastSequenceSeen       BigInt?
  equity                 Decimal? @db.Decimal(18, 4)
  balance                Decimal? @db.Decimal(18, 4)
  margin                 Decimal? @db.Decimal(18, 4)
  freeMargin             Decimal? @db.Decimal(18, 4)
  connectedToTradeServer Boolean
  tradeAllowedTerminal   Boolean
  tradeAllowedProgram    Boolean
  tradeAllowedAccount    Boolean
  tradeAllowedExpert     Boolean
  hostHealthJson         Json?
  localModeFlagsJson     Json?
  symbolCapabilitiesJson Json?
  eaVersion              String?
  sentAt                 DateTime
  createdAt              DateTime @default(now())

  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([agentId, sentAt])
}

model ExecutionReport {
  id              String   @id @default(cuid())
  commandId       String
  agentId         String
  brokerAccountId String
  userId          String
  symbol          String
  brokerTicket    String?
  executionResult String
  rejectionCode   String?
  executionPrice  Decimal? @db.Decimal(18, 8)
  executionVolume Decimal? @db.Decimal(18, 4)
  sl              Decimal? @db.Decimal(18, 8)
  tp              Decimal? @db.Decimal(18, 8)
  executionTime   DateTime
  rawResultJson   Json?
  createdAt       DateTime @default(now())

  command       PublishedCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  agent         Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount    @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PositionSnapshot {
  id              String   @id @default(cuid())
  agentId         String
  brokerAccountId String
  snapshotTime    DateTime
  equity          Decimal  @db.Decimal(18, 4)
  balance         Decimal  @db.Decimal(18, 4)
  margin          Decimal? @db.Decimal(18, 4)
  freeMargin      Decimal? @db.Decimal(18, 4)
  positionsJson   Json
  ordersJson      Json
  createdAt       DateTime @default(now())

  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([brokerAccountId, snapshotTime])
}

model AgentLease {
  id              String   @id @default(cuid())
  brokerAccountId String
  agentId         String
  leaseStartedAt  DateTime
  leaseExpiresAt  DateTime
  leaseStatus     String
  createdAt       DateTime @default(now())

  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)
  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([brokerAccountId, leaseStatus])
  @@index([agentId, leaseStatus])
}

model RiskEvent {
  id              String   @id @default(cuid())
  userId          String
  brokerAccountId String
  symbol          String?
  eventType       String
  severity        String
  detailsJson     Json
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerAccount BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([brokerAccountId, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorType    String
  actorId      String
  eventType    String
  entityType   String
  entityId     String
  metadataJson Json
  createdAt    DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorType, createdAt])
  @@index([entityType, createdAt])
}

model PlatformSetting {
  id                                       Int      @id
  requireActiveSubscription                Boolean  @default(true)
  referralEnabled                          Boolean  @default(true)
  referralDiscountBps                      Int      @default(500)
  referralCommissionBps                    Int      @default(1000)
  supportEmail                             String   @default("support@nisterai.com")
  telegramUrl                              String   @default("https://t.me/nister_ai")
  requireEmailVerification                 Boolean  @default(true)
  loginMaxAttempts                         Int      @default(6)
  loginLockMinutes                         Int      @default(30)
  maxPaymentSubmissionsPerDay              Int      @default(5)
  paymentSubmissionCooldownMins            Int      @default(5)
  userDefaultRiskBps                       Int      @default(200)
  userDefaultDailyLossBps                  Int      @default(600)
  userDefaultMaxConcurrentTrades           Int      @default(3)
  analyticsEnabled                         Boolean  @default(true)
  analyticsProvider                        String   @default("internal")
  analyticsSiteKey                         String?
  analyticsHost                            String?
  sessionReplayEnabled                     Boolean  @default(false)
  sessionReplaySamplePct                   Int      @default(20)
  ga4Enabled                               Boolean  @default(false)
  ga4MeasurementId                         String?
  posthogProjectKey                        String?
  posthogHost                              String?
  posthogSessionReplayEnabled              Boolean  @default(false)
  posthogSessionReplaySamplePct            Int      @default(20)
  posthogFeatureFlagsEnabled               Boolean  @default(true)
  turnstileEnabled                         Boolean  @default(false)
  turnstileSiteKey                         String?
  turnstileSecretKey                       String?
  turnstileSecretKeyVersion                Int?
  turnstileProtectSignup                   Boolean  @default(true)
  turnstileProtectLogin                    Boolean  @default(true)
  turnstileProtectForgotPassword           Boolean  @default(true)
  googleSocialAuthEnabled                  Boolean  @default(false)
  googleSocialAuthClientId                 String?
  googleSocialAuthClientSecret             String?
  googleSocialAuthClientSecretKeyVersion   Int?
  facebookSocialAuthEnabled                Boolean  @default(false)
  facebookSocialAuthClientId               String?
  facebookSocialAuthClientSecret           String?
  facebookSocialAuthClientSecretKeyVersion Int?
  signupIpMaxAttempts                      Int      @default(8)
  signupIpWindowMinutes                    Int      @default(60)
  signupIpLockMinutes                      Int      @default(60)
  signupEmailMaxAttempts                   Int      @default(5)
  signupEmailWindowMinutes                 Int      @default(1440)
  signupEmailLockMinutes                   Int      @default(1440)
  signupBlockDisposableDomains             Boolean  @default(true)
  signupDisposableDomains                  Json?
  enforceVerifiedEmailForActivation        Boolean  @default(true)
  experimentPricingEnabled                 Boolean  @default(true)
  experimentPricingRolloutPct              Int      @default(100)
  liveChatEnabled                          Boolean  @default(false)
  liveChatProvider                         String   @default("telegram")
  liveChatAppId                            String?
  liveChatSalesPrompt                      String   @default("Questions before you pay? Use live chat and get a direct answer before checkout.")
  abandonmentRecoveryEnabled               Boolean  @default(true)
  abandonmentReminderDelayMins             Int      @default(240)
  abandonmentEscalationDelayMins           Int      @default(1440)
  abandonmentMaxReminders                  Int      @default(3)
  trustProofEnabled                        Boolean  @default(true)
  trustProofWindowDays                     Int      @default(30)
  trustReviewSlaHours                      Int      @default(6)
  trustGuaranteeCopy                       String   @default("Manual wallet validation and admin review are required before activation.")
  offerAddonsEnabled                       Boolean  @default(false)
  offerUrgencyBannerEnabled                Boolean  @default(true)
  offerUrgencyCopy                         String   @default("Payment queue is reviewed throughout the day. Submit now to secure the next review cycle.")
  marketForexEnabled                       Boolean  @default(true)
  marketStocksEnabled                      Boolean  @default(false)
  marketOptionsEnabled                     Boolean  @default(false)
  tronSolidityNodeUrl                      String?
  tronFullNodeUrl                          String?
  tronApiKey                               String?
  tronMerchantReceiveAddress               String?
  tronUsdtContractAddress                  String?
  tronInvoiceTtlMinutes                    Int      @default(30)
  tronInvoiceGraceMinutes                  Int      @default(20)
  tronAmountReuseCooldownMinutes           Int      @default(240)
  tronInvoiceOffsetSlots                   Int      @default(99)
  tronWatcherMaxBlocks                     Int      @default(200)
  updatedAt                                DateTime @updatedAt
}

model UserTradingProfile {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  accountState           UserAccountState @default(PENDING_REVIEW)
  fundsState             UserFundsState   @default(UNFUNDED)
  tradeState             UserTradeState   @default(ONBOARDING)
  availableFundsUsdCents Int?
  allocatedFundsUsdCents Int?
  maxRiskPerTradeBps     Int              @default(200)
  dailyLossLimitBps      Int              @default(600)
  maxConcurrentTrades    Int              @default(3)
  autotradeEnabled       Boolean          @default(false)
  manualNotes            String?
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthRateLimit {
  id            String    @id @default(cuid())
  userId        String?   @unique
  key           String    @unique
  attempts      Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model UserSocialAccount {
  id                String             @id @default(cuid())
  userId            String
  provider          SocialAuthProvider
  providerAccountId String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model CompanionSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, refreshExpiresAt])
}

model EmailSetting {
  id                 Int      @id
  host               String
  port               Int
  username           String
  password           String   @db.LongText
  passwordKeyVersion Int?
  fromEmail          String
  fromName           String?
  secure             Boolean  @default(false)
  enabled            Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
