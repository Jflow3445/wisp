  amountCents Int
  address     String
  network     String   @default("TRC20")
  token       String   @default("USDT")
  status      String   @default("PENDING")
  txHash      String?  @unique
  reviewedBy  String?
  reviewNote  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, requestKey])
  @@index([status, createdAt])
}

model FlightWalletEntry {
  id          String   @id @default(cuid())
  userId      String
  reference   String   @unique
  kind        String
  amountCents Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
}

model FlightAudit {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  subjectId String?
  details   Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}


model FlightReferralReward {
  id             String   @id @default(cuid())
  roundId        String
  level          Int      @default(1)
  rateBps        Int      @default(0)
  userId         String
  referredUserId String
  amountCents    Int
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  paidAt         DateTime?
  round          FlightRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  recipient      User @relation("FlightReferralRecipient", fields: [userId], references: [id], onDelete: Restrict)
  referredUser   User @relation("FlightReferralSource", fields: [referredUserId], references: [id], onDelete: Restrict)
  @@unique([roundId, level])
  @@unique([roundId, userId])
  @@index([userId, referredUserId, status])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}
