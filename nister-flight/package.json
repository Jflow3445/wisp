{
  "name": "nister-flight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "tsx --test src/lib/__tests__/flight*.test.ts",
    "test:integration": "node --env-file=.env.test --import tsx scripts/flight-integration.ts",
    "test:risk": "node --import tsx scripts/flight-risk-check.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.0",
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.0",
    "next": "^16.2.0",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "prisma": "^6.17.1",
    "@types/nodemailer": "^7.0.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "esbuild": "^0.28.1"
  }
}
