# Merge into the EXISTING /etc/pay.env. No live play is enabled by this example.
SPIN_PAID_PLAY_ENABLED=0
SPIN_OPERATIONS_APPROVED=0
# A successful interactive game-manager login authorizes play for the configured
# inactivity window (48 hours by default). Ghost Mode still needs explicit restoration.
# Exact existing APP_ADMIN_USER names permitted to manage the game, comma separated.
SPIN_GAME_MANAGERS=
# Generate at least 32 random bytes: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Keep a backed-up, stable key outside the database. Never rotate without re-sign/export planning.
SPIN_AUDIT_KEY=
# Game administration uses the existing WISP administrator session and CSRF checks.
